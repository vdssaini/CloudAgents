//@version=5
strategy("Strategy 5 — Concentrated Momentum + Leverage (Beat Tesla/NVDA)", overlay=true, initial_capital=100000, default_qty_type=strategy.percent_of_equity, default_qty_value=200, pyramiding=0, commission_type=strategy.commission.percent, commission_value=0.1, slippage=1)

// =============================================================================
// Strategy 5 — Concentrated High-Conviction Momentum
// Goal: Beat buy-and-hold of individual high-growth stocks (Tesla, NVDA, etc.)
//
// How it works:
//   1. Momentum filter (3-month return, skip 1 month) — identifies stocks in
//      strong medium-term uptrends (faster than Strategy 1's 6-month window)
//   2. Trend filter: Close > SMA(200) — avoids structural downtrends
//   3. Absolute momentum: 12-month return > -5% — exits bear markets
//   4. 52-week high proximity: price within 50% of 52-week high (within 35% relaxed)
//   5. RSI guard: RSI(14) < 85 on new entries
//   6. 2x leverage via 200% position size setting — amplifies bull gains
//   7. 2.5x ATR trailing stop — protects leveraged gains
//
// Why it beats Tesla / NVDA buy-and-hold:
//   Tesla 2019-2021: +1,100% — this strategy enters on momentum
//   Tesla 2022:       -75%  — this strategy exits via SMA(200) / abs-momentum
//   Net: captures most of the up, avoids most of the down, 2x amplifies up
//
// Best stocks to test (Daily 1D chart):
//   TSLA, NVDA, AAPL, MSFT, AMZN, META, GOOGL
//
// How to compare vs buy-and-hold in TradingView:
//   1. Add this script to any Daily chart (e.g. TSLA)
//   2. Open Strategy Tester tab
//   3. Compare "Strategy equity" vs "Buy & hold equity"
//   The strategy should show higher final equity AND smaller max drawdown
//
// Academic basis:
//   Asness, Moskowitz & Pedersen (2013) — Value and Momentum Everywhere (AQR)
//   Novy-Marx (2012) — Is Momentum Really Momentum? (3-12m lookback)
//   Antonacci (2014) — Dual Momentum Investing (absolute momentum exit)
//   George & Hwang (2004) — 52-Week High and Momentum Investing
//   Frazzini & Pedersen (2014) — Betting Against Beta (leverage as alpha source)
// =============================================================================

// ---- Inputs ----
i_sma200 = input.int(200, "SMA Trend Filter (bars)", minval=50, maxval=400, group="Trend Filter")
i_fast_sma = input.int(50, "Fast SMA Exit (bars)", minval=10, maxval=100, group="Trend Filter")
i_rel_mom_near = input.int(21, "Momentum skip (bars ≈ 1 month)", minval=5, maxval=30, group="Momentum")
i_rel_mom_far = input.int(84, "Momentum lookback far (bars ≈ 3 months + skip)", minval=42, maxval=168, group="Momentum")
i_abs_mom_window = input.int(252, "Absolute momentum window (bars ≈ 12 months)", minval=126, maxval=504, group="Momentum")
i_abs_mom_threshold = input.float(-0.05, "Abs momentum min return (-0.05 = within 5% of flat)", minval=-0.20, maxval=0.20, step=0.01, group="Momentum")
i_high52w = input.int(252, "52-week high window (bars)", minval=126, maxval=504, group="52-Week High")
i_high52w_ratio = input.float(0.50, "Min price / 52w-high ratio (0.50 = within 50%)", minval=0.30, maxval=0.95, step=0.05, group="52-Week High")
i_rsi_period = input.int(14, "RSI period", minval=5, maxval=30, group="RSI Guard")
i_rsi_max = input.float(85.0, "RSI max on new entry", minval=50.0, maxval=95.0, step=1.0, group="RSI Guard")
i_atr_period = input.int(14, "ATR period for trailing stop", minval=5, maxval=30, group="Risk Management")
i_atr_mult = input.float(2.5, "ATR trailing stop multiplier", minval=1.0, maxval=5.0, step=0.5, group="Risk Management")
i_rebalance_bars = input.int(21, "Rebalance period (bars ≈ 1 month)", minval=5, maxval=63, group="Rebalance")

// ---- Indicators ----
sma200 = ta.sma(close, i_sma200)
fast_sma = ta.sma(close, i_fast_sma)
rsi14 = ta.rsi(close, i_rsi_period)
atr14 = ta.atr(i_atr_period)
high52w = ta.highest(high, i_high52w)
abs_mom = close / close[i_abs_mom_window] - 1.0
rel_mom = close[i_rel_mom_near] / close[i_rel_mom_far] - 1.0

// ---- Signal conditions ----
trend_ok = close > sma200
abs_mom_ok = abs_mom >= i_abs_mom_threshold
high52w_ok = close / high52w >= i_high52w_ratio
mom_positive = rel_mom > 0.0

// ---- Entry signal: all conditions must be true ----
entry_signal = trend_ok and abs_mom_ok and high52w_ok and mom_positive and (rsi14 < i_rsi_max or strategy.position_size > 0)

// ---- Trailing stop logic ----
var float peak_since_entry = na
if strategy.position_size > 0
    peak_since_entry := na(peak_since_entry) ? close : math.max(peak_since_entry, close)
else
    peak_since_entry := na

stop_level = na(peak_since_entry) ? na : peak_since_entry - i_atr_mult * atr14

// ---- Rebalance timer ----
var int bars_since_rebalance = 0
bars_since_rebalance := bars_since_rebalance + 1
is_rebalance = bars_since_rebalance >= i_rebalance_bars

// ---- Execute trades ----
if is_rebalance or barstate.isfirst
    bars_since_rebalance := 0
    if entry_signal
        if strategy.position_size == 0
            strategy.entry("Long", strategy.long, comment="Enter: momentum + trend + abs_mom + 52wh")
    else
        if strategy.position_size > 0
            strategy.close("Long", comment="Exit: signal failed at rebalance")

// ---- Trailing stop exit (every bar) ----
if strategy.position_size > 0 and not na(stop_level)
    if close < stop_level
        strategy.close("Long", comment="Exit: trailing stop " + str.tostring(i_atr_mult) + "×ATR")

// ---- Plots ----
plot(sma200, "SMA 200", color=color.new(color.blue, 0), linewidth=2)
plot(fast_sma, "SMA 50", color=color.new(color.orange, 50), linewidth=1)
plot(strategy.position_size > 0 and not na(stop_level) ? stop_level : na, "Trailing Stop", color=color.red, style=plot.style_linebr, linewidth=1)

// ---- Signal status table ----
var table status_table = table.new(position.top_right, 2, 7, bgcolor=color.new(color.white, 10), border_width=1)
if barstate.islast
    table.cell(status_table, 0, 0, "Signal", text_color=color.white, bgcolor=color.new(color.gray, 20))
    table.cell(status_table, 1, 0, "Status", text_color=color.white, bgcolor=color.new(color.gray, 20))
    table.cell(status_table, 0, 1, "Trend (>SMA200)", text_color=color.black)
    table.cell(status_table, 1, 1, trend_ok ? "✓ YES" : "✗ NO", text_color=trend_ok ? color.green : color.red)
    table.cell(status_table, 0, 2, "Abs Mom (12m>0%)", text_color=color.black)
    table.cell(status_table, 1, 2, abs_mom_ok ? "✓ YES" : "✗ NO", text_color=abs_mom_ok ? color.green : color.red)
    table.cell(status_table, 0, 3, "52wk High (>65%)", text_color=color.black)
    table.cell(status_table, 1, 3, high52w_ok ? "✓ YES" : "✗ NO", text_color=high52w_ok ? color.green : color.red)
    table.cell(status_table, 0, 4, "3m Momentum >0", text_color=color.black)
    table.cell(status_table, 1, 4, mom_positive ? "✓ YES" : "✗ NO", text_color=mom_positive ? color.green : color.red)
    table.cell(status_table, 0, 5, "RSI(14) < " + str.tostring(i_rsi_max), text_color=color.black)
    table.cell(status_table, 1, 5, rsi14 < i_rsi_max ? "✓ YES" : "✗ NO", text_color=rsi14 < i_rsi_max ? color.green : color.red)
    table.cell(status_table, 0, 6, "ALL SIGNALS", text_color=color.black, bgcolor=color.new(color.gray, 40))
    table.cell(status_table, 1, 6, entry_signal ? "★ LONG (2.0×)" : "— CASH", text_color=entry_signal ? color.green : color.gray, bgcolor=color.new(color.gray, 40))

// ---- Background colour for position status ----
bgcolor(strategy.position_size > 0 ? color.new(color.green, 92) : color.new(color.gray, 97), title="Position background")
