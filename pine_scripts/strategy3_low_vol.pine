// Strategy 3 — Low Volatility Factor
// Pine Script v5 | TradingView Strategy
// Port of src/strategy_low_vol.py (LowVolStrategy) from the CloudAgents backtesting system.
// Academic basis: Baker, Bradley & Wurgler (2011) "Benchmarks as Limits to Arbitrage";
//                 Frazzini & Pedersen (2014) "Betting Against Beta" (AQR)
// Recommended: Daily (1D) chart.
// Best stocks: JNJ, PG, KO, WMT, MCD, VZ, MMM, CL, MRK, ABT
// (These are consistently in the lowest-volatility quintile of the S&P 500)
//
// ENTRY (checked every 21 bars — monthly rebalance, ALL must be true):
//   1. Close > SMA(200)              — uptrend filter (same as Python trend_sma_window=200)
//   2. 20-day ann. vol > 5%          — minimum activity filter (Python min_vol_annual=0.05)
//   3. 20-day ann. vol < threshold   — stock is in a low-vol regime
//      Cross-sectional ranking (picking the 20 lowest-vol stocks out of 100) is not possible
//      in single-security TradingView. Instead, enter when the stock's own 20-day ann. vol
//      is below a configurable threshold (default 28%). This approximates membership in the
//      lowest-vol quintile for large-cap US stocks (typical 20-day ann. vol range 10%–60%).
//      Set lower (20%) for blue-chip defensives; raise (35%) for moderate-vol names.
//
// EXIT (first condition wins, checked every bar):
//   1. Vol spike: current 20-day ann. vol > entry vol × 2.5   (Python vol_exit_mult=2.5)
//   2. Trend exit: Close < SMA(200)                           (Python trend filter)
//   3. Monthly rebalance exit (every 21 bars): stock no longer qualifies

//@version=5
strategy(title="Low Volatility Factor (CloudAgents Strategy 3)", shorttitle="LOW-VOL", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=100, initial_capital=100000, commission_type=strategy.commission.percent, commission_value=0.10, slippage=5)

// ── Inputs ────────────────────────────────────────────────────────────────────
i_sma_window = input.int(200, "Trend SMA window", minval=50, tooltip="Python: trend_sma_window=200")
i_vol_window = input.int(20, "Realized vol window (days)", minval=5, tooltip="Python: vol_window=20. Rolling std of daily log-returns, annualised by sqrt(252).")
i_min_vol_ann = input.float(5.0, "Min ann. vol % (activity filter)", minval=0.5, maxval=20, step=0.5, tooltip="Python: min_vol_annual=0.05 (5%). Exclude illiquid or artificially flat stocks.")
i_max_vol_ann = input.float(28.0, "Max ann. vol % (low-vol entry)", minval=5, maxval=80, step=1.0, tooltip="Enter only when 20-day ann. vol < this. Proxy for bottom-quintile in a 100-stock universe. Use 20% for defensive blue-chips (JNJ/PG), 28% for normal large-caps, 35% for moderate-vol names (MRK/ABT).")
i_vol_exit_mult = input.float(2.5, "Vol spike exit multiplier", minval=1.0, maxval=5.0, step=0.5, tooltip="Python: vol_exit_mult=2.5. Exit if 20-day vol rises above entry_vol x this factor.")
i_rebalance_days = input.int(21, "Rebalance every N bars", minval=1, tooltip="Python: rebalance_days=21 (monthly). Re-evaluate entry/exit every N bars.")

// ── Indicators ────────────────────────────────────────────────────────────────
sma200 = ta.sma(close, i_sma_window)
above_sma = close > sma200

log_ret = math.log(close / close[1])
ann_vol_pct = ta.stdev(log_ret, i_vol_window) * math.sqrt(252) * 100.0

above_min_vol = ann_vol_pct >= i_min_vol_ann
below_max_vol = ann_vol_pct <= i_max_vol_ann

// ── Trailing Entry-Vol Tracking ───────────────────────────────────────────────
var float entry_vol_level = na
in_position = strategy.position_size > 0

// ── Conditions ────────────────────────────────────────────────────────────────
is_rebalance_bar = bar_index % i_rebalance_days == 0
entry_signal = is_rebalance_bar and above_sma and above_min_vol and below_max_vol and not in_position

vol_spike_exit = in_position and not na(entry_vol_level) and ann_vol_pct > entry_vol_level * i_vol_exit_mult
trend_exit = in_position and not above_sma
rebalance_exit = is_rebalance_bar and in_position and not vol_spike_exit and not trend_exit and (not above_sma or not above_min_vol or not below_max_vol)
any_exit = vol_spike_exit or trend_exit or rebalance_exit

// ── Execute Orders ────────────────────────────────────────────────────────────
if entry_signal
    strategy.entry("Long", strategy.long)
    entry_vol_level := ann_vol_pct

if vol_spike_exit
    strategy.close("Long", comment="Vol Spike Exit")
    entry_vol_level := na

if trend_exit and not vol_spike_exit
    strategy.close("Long", comment="Trend Exit <SMA200")
    entry_vol_level := na

if rebalance_exit
    strategy.close("Long", comment="Rebalance Exit")
    entry_vol_level := na

// ── Plots ─────────────────────────────────────────────────────────────────────
plot(sma200, "SMA 200", color=color.new(color.blue, 0), linewidth=2)
low_vol_zone = above_sma and above_min_vol and below_max_vol
bgcolor(low_vol_zone ? color.new(color.teal, 88) : na, title="Low-Vol Entry Zone")
plotshape(entry_signal, title="Entry", style=shape.triangleup, location=location.belowbar, color=color.new(color.teal, 0), size=size.small)
plotshape(any_exit, title="Exit", style=shape.triangledown, location=location.abovebar, color=color.new(color.red, 0), size=size.small)

// ── Info Table ────────────────────────────────────────────────────────────────
var table info_tbl = table.new(position.top_right, 2, 7, bgcolor=color.new(color.white, 10), border_width=1)
if barstate.islast
    table.cell(info_tbl, 0, 0, "Indicator", text_color=color.gray, text_size=size.small)
    table.cell(info_tbl, 1, 0, "Value", text_color=color.gray, text_size=size.small)
    table.cell(info_tbl, 0, 1, "SMA(200)", text_size=size.small)
    table.cell(info_tbl, 1, 1, str.tostring(math.round(sma200, 2)), text_color=above_sma ? color.green : color.red, text_size=size.small)
    table.cell(info_tbl, 0, 2, "20d Ann.Vol%", text_size=size.small)
    table.cell(info_tbl, 1, 2, str.tostring(math.round(ann_vol_pct, 1)) + "%", text_color=below_max_vol and above_min_vol ? color.teal : color.red, text_size=size.small)
    table.cell(info_tbl, 0, 3, "Min Vol OK", text_size=size.small)
    table.cell(info_tbl, 1, 3, above_min_vol ? "YES" : "NO", text_color=above_min_vol ? color.green : color.red, text_size=size.small)
    table.cell(info_tbl, 0, 4, "Low-Vol OK", text_size=size.small)
    table.cell(info_tbl, 1, 4, below_max_vol ? "YES" : "NO", text_color=below_max_vol ? color.green : color.red, text_size=size.small)
    table.cell(info_tbl, 0, 5, "Entry Vol%", text_size=size.small)
    table.cell(info_tbl, 1, 5, in_position and not na(entry_vol_level) ? str.tostring(math.round(entry_vol_level, 1)) + "%" : "N/A", text_size=size.small)
    table.cell(info_tbl, 0, 6, "In Position", text_size=size.small)
    table.cell(info_tbl, 1, 6, in_position ? "YES" : "NO", text_color=in_position ? color.green : color.red, text_size=size.small)
