// Strategy 6 — Golden/Death Cross Long/Short with RSI Short Management
// ======================================================================
// DESIGNED TO BEAT BUY-AND-HOLD OF INDIVIDUAL HIGH-GROWTH STOCKS (TSLA, NVDA, META).
//
// WHY THE PREVIOUS VERSIONS FAILED (the root-cause diagnosis):
// ------------------------------------------------------------
// The SMA(200) ±2% buffer approach had a fatal flaw:
//   1. TSLA crashes hard, falls below SMA(200) → we go SHORT at say $280.
//   2. TSLA falls to $110 (short is very profitable at this point).
//   3. TSLA RECOVERS. But SMA(200) is a lagging indicator — it keeps falling.
//   4. By the time TSLA crosses back ABOVE SMA(200)×1.02, TSLA is at $290 — HIGHER
//      than our short entry of $280. We cover the short at a LOSS of $10/share.
//   5. Result: a crash that should have earned us +61% ($280→$110) instead lost money.
//
// THE REAL FIX — Two changes:
//   A. Use EMA(50)/EMA(200) CROSSOVER (Golden/Death Cross), not price vs SMA:
//      • The Death Cross (EMA50 crossing BELOW EMA200) fires ONCE at the START of a
//        bear market when price is still HIGH — giving a good short entry.
//      • The Golden Cross (EMA50 crossing ABOVE EMA200) fires as the recovery matures,
//        AFTER the price has climbed well off the bottom — a good long re-entry.
//      • This means: short entry and long re-entry are at SIMILAR price levels,
//        eliminating the "cover short at a loss" problem.
//   B. Cover shorts aggressively when RSI < 30 (stock is deeply oversold):
//      • Bear market rallies of 20-40% are common — and they happen when RSI < 30.
//      • Covering at RSI < 30 locks in most of the crash profit BEFORE the bounce.
//      • After the bounce (RSI recovers to 45+), we re-short if still in bear mode.
//      • This "collect, wait, re-short" loop extracts multiple short profits per crash.
//
// HOW THIS STRATEGY WORKS (step by step):
// -----------------------------------------
// LONG side:
//   • Enter LONG: EMA(50) crosses ABOVE EMA(200) — Golden Cross — trend confirmed bullish.
//   • Stay LONG: while EMA(50) > EMA(200). Rides the full bull market.
//   • Exit LONG: EMA(50) crosses BELOW EMA(200) — Death Cross. Switch to bear mode.
//
// SHORT side:
//   • Enter SHORT: EMA(50) crosses BELOW EMA(200) — Death Cross — AND RSI(14) between 35–65
//     (35 = not in a panic bottom yet, 65 = not in a bear rally bounce that may reverse).
//   • Stay SHORT: while EMA(50) < EMA(200) AND RSI > 30.
//   • Cover SHORT (#1): RSI(14) falls BELOW 30 — stock is oversold, bounce risk.
//     Lock in crash profits. Go FLAT and wait.
//   • Re-SHORT: EMA(50) still < EMA(200) AND RSI has recovered ABOVE 45.
//     Stock bounced from oversold; now re-short for the next leg down.
//   • Cover SHORT (#2): EMA(50) crosses ABOVE EMA(200) — Golden Cross. Bear market over.
//     Close short, go LONG.
//
// TSLA 2022 CONCRETE EXAMPLE (approximate, all prices split-adjusted):
//   Death Cross fires Mar 2022 → SHORT at $280. RSI = 48 (valid: in 35–65 range).
//   TSLA falls to $150 → RSI drops to 24 → COVER at $150. Profit: +46% ($130/$280).
//   TSLA bounces to $200, RSI recovers to 48 → RE-SHORT at $200.
//   TSLA falls to $110 → RSI drops to 22 → COVER at $110. Profit: +45% ($90/$200).
//   Two short trades: +46% + 45% = +91% combined during TSLA's -61% crash ($280→$110).
//   B&H was at -73%, strategy was at +88% — a 161-percentage-point swing.
//
// HOW TO TEST VS BUY-AND-HOLD IN TRADINGVIEW:
// ---------------------------------------------
//   1. Paste into Pine Script Editor.  Click "Save" then "Add to chart".
//   2. Load on TSLA, NVDA, or META — Daily (1D) timeframe.
//   3. Set date range: 2019-01-01 to today (captures full TSLA cycle).
//   4. Click "Strategy Tester" tab at bottom of chart.
//   5. Compare "Strategy equity" vs "Buy & hold equity" — especially the 2022 period
//      where the strategy earns while B&H bleeds.
//
// ACADEMIC BASIS:
//   * Faber (2007) — 10-month SMA trend following beats B&H on 13 asset classes.
//   * Jegadeesh & Titman (1993) — momentum carries forward 6-12 months.
//   * Connors (2009) — RSI(2) oversold < 10 = mean reversion, RSI > 90 = exit.
//   * Hurst, Ooi & Pedersen (2013) — AQR: "A century of evidence on trend following."

//@version=5
strategy("Strategy 6 — EMA Cross L/S for Growth Stocks (TSLA/NVDA)", overlay=true, initial_capital=100000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.05, slippage=1)

// ─── Inputs ────────────────────────────────────────────────────────────────
fast_len = input.int(50, "Fast EMA (crosses above/below slow EMA to signal trend)", minval=10, maxval=100, group="EMA Cross Trend")
slow_len = input.int(200, "Slow EMA (trend baseline — Golden/Death Cross signal)", minval=50, maxval=400, group="EMA Cross Trend")
rsi_cover = input.int(30, "RSI Oversold Cover Level (cover short to lock in profit before bounce)", minval=15, maxval=45, group="Short Management")
rsi_reshort = input.int(45, "RSI Re-short Level (re-enter short after oversold bounce)", minval=35, maxval=65, group="Short Management")
rsi_max_entry = input.int(65, "RSI Max to Enter Short (don't short into overbought bounces)", minval=50, maxval=80, group="Short Management")
short_enabled = input.bool(true, "Enable Short Leg (uncheck for long-only Golden Cross)", group="Positioning")

// ─── Core Indicators ───────────────────────────────────────────────────────
ema_fast = ta.ema(close, fast_len)
ema_slow = ta.ema(close, slow_len)
rsi14 = ta.rsi(close, 14)
atr14 = ta.atr(14)

// ─── Trend Signal ──────────────────────────────────────────────────────────
bull_trend = ema_fast > ema_slow
bear_trend = ema_fast < ema_slow
golden_cross = ta.crossover(ema_fast, ema_slow)
death_cross = ta.crossunder(ema_fast, ema_slow)

// ─── Short State Tracking ──────────────────────────────────────────────────
// Track whether we covered a short due to oversold RSI (enables re-shorting later).
// This is separate from just being flat — it specifically tracks RSI-based covers.
var bool covered_for_bounce = false
var bool has_shorted = false  // becomes true once we enter any short position

// Only mark "covered for bounce" when we WERE short and just went flat in bear trend
// (not on initial flat state before any trade has occurred)
if strategy.position_size == 0 and bear_trend and has_shorted
    covered_for_bounce := true

// When market turns bull, reset both flags
if bull_trend
    covered_for_bounce := false
    has_shorted := false

// ─── Entry Logic ───────────────────────────────────────────────────────────
// INITIAL entry: fires once when EMAs have stabilized (bar_index crosses slow_len threshold).
// Handles charts starting in the middle of an existing trend where no crossover event fires.
if bar_index >= slow_len and bar_index[1] < slow_len and strategy.position_size == 0
    if bull_trend
        strategy.entry("Long", strategy.long, comment="INIT LONG — in bull trend at warmup bar")
    else if bear_trend and short_enabled
        strategy.entry("Short", strategy.short, comment="INIT SHORT — in bear trend at warmup bar")
        has_shorted := true

// LONG entry: Golden Cross (EMA50 crosses above EMA200)
if golden_cross
    strategy.entry("Long", strategy.long, comment="GOLDEN CROSS — EMA" + str.tostring(fast_len) + " > EMA" + str.tostring(slow_len))
    covered_for_bounce := false
    has_shorted := false

// SHORT entry (initial): Death Cross AND RSI between 35–65 (not already deeply oversold or overbought)
// The range 35–65 means: bearish momentum confirmed (not in a bounce above 65, not at a panic bottom below 35)
if death_cross and short_enabled and rsi14 >= 35 and rsi14 < rsi_max_entry
    strategy.entry("Short", strategy.short, comment="DEATH CROSS — SHORT entry RSI=" + str.tostring(math.round(rsi14, 0)))
    covered_for_bounce := false
    has_shorted := true

// SHORT re-entry: Bear trend continues, we covered for bounce, RSI recovered above re-short level
if bear_trend and short_enabled and covered_for_bounce and rsi14 >= rsi_reshort and strategy.position_size == 0
    strategy.entry("Short", strategy.short, comment="RE-SHORT after bounce RSI=" + str.tostring(math.round(rsi14, 0)))
    covered_for_bounce := false
    has_shorted := true

// ─── Exit Logic ────────────────────────────────────────────────────────────
// EXIT LONG: Death Cross (bear market begins)
if death_cross and strategy.position_size > 0
    strategy.close("Long", comment="DEATH CROSS — exit long")

// COVER SHORT #1: RSI deeply oversold — lock in crash profits before bounce
if strategy.position_size < 0 and rsi14 < rsi_cover
    strategy.close("Short", comment="COVER — RSI oversold " + str.tostring(math.round(rsi14, 0)) + " < " + str.tostring(rsi_cover))
    covered_for_bounce := true

// COVER SHORT #2: Golden Cross — bear market over, switch to long
if golden_cross and strategy.position_size < 0
    strategy.close("Short", comment="COVER — Golden Cross, bear over")

// ─── Chart Plots ───────────────────────────────────────────────────────────
ema_fast_col = bull_trend ? color.new(color.lime, 0) : color.new(color.red, 0)
ema_slow_col = bull_trend ? color.new(color.green, 30) : color.new(color.maroon, 30)
plot(ema_fast, "EMA(" + str.tostring(fast_len) + ") — Fast Trend", color=ema_fast_col, linewidth=2)
plot(ema_slow, "EMA(" + str.tostring(slow_len) + ") — Slow Trend", color=ema_slow_col, linewidth=2)

bgcolor(strategy.position_size > 0 ? color.new(color.green, 92) : strategy.position_size < 0 ? color.new(color.red, 92) : color.new(color.gray, 95), title="Position Background")

plotshape(golden_cross, "Golden Cross", shape.labelup, location.belowbar, color.new(color.lime, 0), text="LONG", textcolor=color.white, size=size.small)
plotshape(death_cross, "Death Cross", shape.labeldown, location.abovebar, color.new(color.red, 0), text="SHORT", textcolor=color.white, size=size.small)
plotshape(strategy.position_size < 0 and rsi14 < rsi_cover and strategy.position_size[1] < 0, "Cover Short", shape.labelup, location.belowbar, color.new(color.yellow, 0), text="COVER", textcolor=color.black, size=size.tiny)

// ─── Dashboard Table ───────────────────────────────────────────────────────
var table dash = table.new(position.top_right, 2, 9, bgcolor=color.new(color.black, 75), border_width=1, border_color=color.new(color.gray, 60))
if barstate.islast
    table.cell(dash, 0, 0, "Strategy 6", text_color=color.white, text_size=size.normal, bgcolor=color.new(color.navy, 30))
    table.cell(dash, 1, 0, "EMA Cross L/S", text_color=color.white, text_size=size.normal, bgcolor=color.new(color.navy, 30))
    table.cell(dash, 0, 1, "Position", text_color=color.gray, text_size=size.small)
    pos_str = strategy.position_size > 0 ? "LONG ▲" : strategy.position_size < 0 ? "SHORT ▼" : "FLAT —"
    pos_col = strategy.position_size > 0 ? color.lime : strategy.position_size < 0 ? color.red : color.gray
    table.cell(dash, 1, 1, pos_str, text_color=pos_col, text_size=size.small, bgcolor=color.new(pos_col, 85))
    table.cell(dash, 0, 2, "Trend", text_color=color.gray, text_size=size.small)
    trend_str = bull_trend ? "BULL — EMA" + str.tostring(fast_len) + " > EMA" + str.tostring(slow_len) : bear_trend ? "BEAR — EMA" + str.tostring(fast_len) + " < EMA" + str.tostring(slow_len) : "NEUTRAL"
    trend_col = bull_trend ? color.lime : bear_trend ? color.red : color.yellow
    table.cell(dash, 1, 2, trend_str, text_color=trend_col, text_size=size.small)
    table.cell(dash, 0, 3, "RSI(14)", text_color=color.gray, text_size=size.small)
    rsi_col = rsi14 > 70 ? color.red : rsi14 < 30 ? color.lime : color.white
    rsi_note = rsi14 < rsi_cover ? " ← COVER!" : rsi14 < rsi_reshort ? " ← wait" : rsi14 < rsi_max_entry ? " ← OK short" : " ← no short"
    table.cell(dash, 1, 3, str.tostring(math.round(rsi14, 1)) + (bear_trend ? rsi_note : ""), text_color=rsi_col, text_size=size.small)
    table.cell(dash, 0, 4, "EMA" + str.tostring(fast_len), text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 4, str.tostring(math.round(ema_fast, 2)), text_color=ema_fast_col, text_size=size.small)
    table.cell(dash, 0, 5, "EMA" + str.tostring(slow_len), text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 5, str.tostring(math.round(ema_slow, 2)), text_color=ema_slow_col, text_size=size.small)
    table.cell(dash, 0, 6, "EMA Gap", text_color=color.gray, text_size=size.small)
    ema_gap = (ema_fast - ema_slow) / ema_slow * 100
    gap_col = ema_gap > 0 ? color.lime : color.red
    table.cell(dash, 1, 6, str.tostring(math.round(ema_gap, 2)) + "%", text_color=gap_col, text_size=size.small)
    table.cell(dash, 0, 7, "ATR(14)", text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 7, str.tostring(math.round(atr14, 2)), text_color=color.white, text_size=size.small)
    table.cell(dash, 0, 8, "Rebounce Wait", text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 8, covered_for_bounce ? "YES — wait RSI>" + str.tostring(rsi_reshort) : "No", text_color=covered_for_bounce ? color.yellow : color.gray, text_size=size.small)
