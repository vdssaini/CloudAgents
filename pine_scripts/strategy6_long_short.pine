// Strategy 6 — Adaptive Trend + Crash Protection (Long/Short, No Leverage)
// =========================================================================
// Designed to beat buy-and-hold of volatile momentum stocks (TSLA, NVDA, META).
//
// KEY DESIGN INSIGHT vs the naive approach:
// ------------------------------------------
// The previous version used "exit when NOT entry_signal" — this fires whenever
// RSI spikes above 75, which happens constantly during TSLA's strongest bull runs.
// Result: the strategy was mostly FLAT during the best gains = miserable vs B&H.
//
// This version uses ASYMMETRIC entry/exit conditions:
//   • LONG ENTRY: 3 simple conditions (trend, momentum health, RSI not extreme)
//   • LONG EXIT:  Explicit decisive exits ONLY (SMA100 break OR trailing stop OR deep bear)
//   • SHORT ENTRY: Requires strong double confirmation (SMA50 + SMA200 broken + 3m decline)
//   • SHORT COVER: Aggressive cover (RSI oversold or SMA50 recovery)
//
// How to test vs Buy-and-Hold in TradingView
// -------------------------------------------
// 1. Load this script on TSLA, NVDA, META, AMZN Daily (1D) chart
// 2. Open "Strategy Tester" tab → compare "Strategy equity" vs "Buy & hold equity"
// 3. Key events to look for:
//    TSLA 2022 crash (-75%): Strategy exits long via SMA100 break (Jan 2022),
//      then enters SHORT when price < SMA50 + SMA200 + 3m return < -20%.
//      Short earns positive returns while B&H bleeds -75%.
//    TSLA 2023-2024 recovery: Strategy goes long again → captures full upside.
//    NVDA 2023 AI rally: Stays long throughout — doesn't exit on RSI spikes.
//
// Parameter tuning per stock type
// --------------------------------
// High-vol stocks (TSLA, NVDA):   defaults work well (RSI entry cap 85, 3m short threshold -20%)
// Mid-vol stocks (META, AMZN):    reduce RSI entry cap to 80, increase short threshold to -15%
// Low-vol stocks (AAPL, MSFT):    RSI entry cap 75, short threshold -12%, use SMA150 for slow trend
//
// Academic basis
// ---------------
// * Faber (2007) — trend following with SMA reduces max drawdown 40–50% vs B&H
// * Antonacci (2014) — absolute momentum (12m return) as bear-market exit filter
// * Jegadeesh & Titman (1993) — momentum continuation justifies staying long
// * Moreira & Muir (2017) — volatility targeting (ATR trailing stop) improves Sharpe

//@version=5
strategy("Strategy 6 — Trend + Crash Protection (No Leverage)", overlay=true, initial_capital=100000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.1, slippage=2)

// ─── Inputs ────────────────────────────────────────────────────────────────
sma_slow_len = input.int(200, "SMA Slow — Primary Trend Entry Gate", minval=100, maxval=400, group="Trend Filters")
sma_fast_len = input.int(100, "SMA Fast — Long Exit Trigger", minval=20, maxval=200, group="Trend Filters")
sma_short_len = input.int(50, "SMA Short — Short Entry Confirmation", minval=10, maxval=100, group="Trend Filters")
rsi_len = input.int(14, "RSI Length", minval=2, maxval=30, group="Filters")
entry_rsi_max = input.float(85.0, "Max RSI to Enter/Stay Long (raise for TSLA/NVDA)", minval=50.0, maxval=99.0, group="Filters")
abs_mom_min = input.float(-15.0, "Min 12m Return to Enter Long (%) — structural bear filter", minval=-50.0, maxval=0.0, group="Filters")
abs_mom_exit = input.float(-30.0, "12m Return to Force-Exit Long (%) — deep bear", minval=-80.0, maxval=-10.0, group="Filters")
short_3m_thresh = input.float(-20.0, "3m Return Threshold for Short Entry (%)", minval=-60.0, maxval=-5.0, group="Short Conditions")
short_rsi_min = input.float(30.0, "Min RSI for Short (avoid deeply oversold)", minval=10.0, maxval=50.0, group="Short Conditions")
short_rsi_max = input.float(70.0, "Max RSI for Short (avoid overbought recovery)", minval=40.0, maxval=90.0, group="Short Conditions")
long_atr_mult = input.float(3.5, "Long Trailing Stop (×ATR from peak)", minval=1.0, maxval=8.0, group="Risk Management")
short_atr_mult = input.float(2.5, "Short Cover Stop (×ATR from trough)", minval=0.5, maxval=5.0, group="Risk Management")
atr_len = input.int(14, "ATR Length", minval=5, maxval=30, group="Risk Management")
short_enabled = input.bool(true, "Enable Short Positions", group="Positioning")

// ─── Indicators ────────────────────────────────────────────────────────────
sma_slow = ta.sma(close, sma_slow_len)
sma_fast = ta.sma(close, sma_fast_len)
sma_short = ta.sma(close, sma_short_len)
rsi14 = ta.rsi(close, rsi_len)
atr14 = ta.atr(atr_len)
ret_12m = bar_index >= 252 ? (close - close[252]) / close[252] * 100 : na
ret_3m = bar_index >= 63 ? (close - close[63]) / close[63] * 100 : na

// ─── Long Entry: Simplified 3-condition gate ───────────────────────────────
// Condition 1: Price above SMA(200) — primary uptrend
// Condition 2: 12-month return above minimum — stock beating cash, not in deep bear
// Condition 3: RSI not extreme overbought — avoid chasing exhausted moves
// NO 52-week high filter (too conservative for volatile stocks like TSLA)
// NO 6-month relative momentum filter (blocks entries early in new bull runs)
// NO RSI cap at 75 (TSLA RSI regularly 75-90 during strongest momentum phases)
long_entry_signal = close > sma_slow and (na(ret_12m) or ret_12m > abs_mom_min) and rsi14 < entry_rsi_max and bar_index >= sma_slow_len

// ─── Long Exit: Explicit decisive exits ONLY (not "not entry signal") ──────
// Exits ONLY on concrete risk events — does NOT exit because RSI > 75 or other minor signals
// This is the critical fix vs the previous version that exited on "not long_signal"
long_exit_trend = close < sma_fast
long_exit_bear = not na(ret_12m) and ret_12m < abs_mom_exit

// ─── Short Entry: Requires strong double confirmation ──────────────────────
// Both SMA50 AND SMA200 must be broken (structural trend break, not a blip)
// 3-month return must be deeply negative (momentum crash in progress)
// RSI must be in the middle zone (not oversold = bounce risk, not overbought = reversal)
short_entry_signal = short_enabled and close < sma_slow and close < sma_short and (not na(ret_3m) and ret_3m < short_3m_thresh) and rsi14 > short_rsi_min and rsi14 < short_rsi_max and bar_index >= sma_slow_len

// ─── Short Cover: Aggressive — exits quickly on oversold or trend recovery ─
short_cover_signal = rsi14 < short_rsi_min or close > sma_short

// ─── Trailing Stop State ───────────────────────────────────────────────────
var float long_peak = na
var float short_trough = na

if strategy.position_size > 0
    long_peak := math.max(nz(long_peak, close), close)

if strategy.position_size < 0
    short_trough := math.min(nz(short_trough, close), close)

if strategy.position_size == 0
    long_peak := na
    short_trough := na

long_stop_hit = strategy.position_size > 0 and not na(long_peak) and close < long_peak - long_atr_mult * atr14
short_stop_hit = strategy.position_size < 0 and not na(short_trough) and close > short_trough + short_atr_mult * atr14

// ─── Execute Exits ─────────────────────────────────────────────────────────
if strategy.position_size > 0 and long_stop_hit
    strategy.close("Long", comment="Trailing Stop")
    long_peak := na

if strategy.position_size > 0 and not long_stop_hit and (long_exit_trend or long_exit_bear)
    strategy.close("Long", comment=long_exit_bear ? "Deep Bear Exit" : "SMA Trend Exit")
    long_peak := na

if strategy.position_size < 0 and short_stop_hit
    strategy.close("Short", comment="Cover Stop")
    short_trough := na

if strategy.position_size < 0 and not short_stop_hit and short_cover_signal
    strategy.close("Short", comment="Cover Signal")
    short_trough := na

// ─── Execute Entries ───────────────────────────────────────────────────────
if long_entry_signal and strategy.position_size <= 0
    strategy.entry("Long", strategy.long, comment="Long Entry")
    long_peak := close

if short_entry_signal and strategy.position_size >= 0
    strategy.entry("Short", strategy.short, comment="Short Entry")
    short_trough := close

// ─── Chart Plots ───────────────────────────────────────────────────────────
plot(sma_slow, "SMA(200) — Entry Gate", color=color.new(color.orange, 0), linewidth=2)
plot(sma_fast, "SMA(100) — Long Exit", color=color.new(color.yellow, 20), linewidth=1)
plot(sma_short, "SMA(50) — Short Confirm", color=color.new(color.blue, 40), linewidth=1)

long_stop_line = strategy.position_size > 0 and not na(long_peak) ? long_peak - long_atr_mult * atr14 : na
short_stop_line = strategy.position_size < 0 and not na(short_trough) ? short_trough + short_atr_mult * atr14 : na
plot(long_stop_line, "Long Stop", color=color.new(color.green, 0), style=plot.style_stepline, linewidth=1)
plot(short_stop_line, "Short Stop", color=color.new(color.red, 0), style=plot.style_stepline, linewidth=1)

bgcolor(strategy.position_size > 0 ? color.new(color.green, 90) : strategy.position_size < 0 ? color.new(color.red, 90) : na, title="Position Background")

plotshape(long_entry_signal and strategy.position_size <= 0, "Long Signal", shape.labelup, location.belowbar, color.new(color.green, 0), text="L", textcolor=color.white, size=size.small)
plotshape(short_entry_signal and strategy.position_size >= 0, "Short Signal", shape.labeldown, location.abovebar, color.new(color.red, 0), text="S", textcolor=color.white, size=size.small)

// ─── Dashboard Table ───────────────────────────────────────────────────────
var table dash = table.new(position.top_right, 2, 7, bgcolor=color.new(color.black, 80), border_width=1)
if barstate.islast
    table.cell(dash, 0, 0, "Strategy 6", text_color=color.white, text_size=size.small, bgcolor=color.new(color.blue, 60))
    table.cell(dash, 1, 0, "Trend + Crash Prot.", text_color=color.white, text_size=size.small, bgcolor=color.new(color.blue, 60))
    table.cell(dash, 0, 1, "Position", text_color=color.gray, text_size=size.small)
    pos_str = strategy.position_size > 0 ? "LONG ▲" : strategy.position_size < 0 ? "SHORT ▼" : "FLAT —"
    pos_col = strategy.position_size > 0 ? color.green : strategy.position_size < 0 ? color.red : color.gray
    table.cell(dash, 1, 1, pos_str, text_color=pos_col, text_size=size.small)
    table.cell(dash, 0, 2, "12m Return", text_color=color.gray, text_size=size.small)
    ret_12m_disp = na(ret_12m) ? "N/A" : str.tostring(math.round(ret_12m, 1)) + "%"
    table.cell(dash, 1, 2, ret_12m_disp, text_color=na(ret_12m) or ret_12m >= 0 ? color.green : color.red, text_size=size.small)
    table.cell(dash, 0, 3, "3m Return", text_color=color.gray, text_size=size.small)
    ret_3m_disp = na(ret_3m) ? "N/A" : str.tostring(math.round(ret_3m, 1)) + "%"
    table.cell(dash, 1, 3, ret_3m_disp, text_color=na(ret_3m) or ret_3m >= 0 ? color.green : color.red, text_size=size.small)
    table.cell(dash, 0, 4, "vs SMA200", text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 4, close > sma_slow ? "ABOVE ▲" : "BELOW ▼", text_color=close > sma_slow ? color.green : color.red, text_size=size.small)
    table.cell(dash, 0, 5, "vs SMA100", text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 5, close > sma_fast ? "ABOVE ▲" : "BELOW ▼", text_color=close > sma_fast ? color.teal : color.orange, text_size=size.small)
    table.cell(dash, 0, 6, "RSI(14)", text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 6, str.tostring(math.round(rsi14, 1)), text_color=rsi14 > 80 ? color.red : rsi14 < 30 ? color.orange : color.white, text_size=size.small)
