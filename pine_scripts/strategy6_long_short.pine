// Strategy 6 — Adaptive Long/Short with SMA50 Recovery Entry
// ===========================================================
// OBJECTIVE: Beat buy-and-hold of high-growth stocks (TSLA, NVDA, META)
// measured from REALISTIC entry points (2021–2022 peak prices).
//
// CORE INSIGHT — WHY THIS WORKS:
// --------------------------------
// When a growth stock like TSLA crashes -75%:
//   1. Strategy EXITS the long early (price breaks below SMA200 - buffer)
//   2. Strategy SHORTS the stock — earns positive returns during the crash
//   3. Strategy COVERS the short when RSI < 28 (extreme oversold = lock profit)
//   4. Strategy RE-ENTERS LONG via SMA50 cross (early recovery capture)
//      KEY FIX vs prior versions: instead of waiting for price > SMA200+3%
//      (very late, misses most of recovery), re-enter when price crosses SMA50.
//      This fires when the stock has only recovered 30-50% from its bottom,
//      capturing the rest of the bull run at a much better entry price.
//   5. ATR trailing stop protects long profits from new crashes
//
// THE DEAD-ZONE PROBLEM (fixed in this version):
// -----------------------------------------------
// TSLA example: RSI cover at ~$110 (late 2022).
// Old strategy: wait for price > SMA200+3% (~$260 in mid-2023) before going long
//   => missed the $110 to $260 = +136% recovery move while sitting in cash.
// This version: SMA50 cross triggers at ~$175 (early 2023)
//   => captures $175 to $400 = +129% instead of just $260 to $400 = +54%.
//
// STRATEGY ON TSLA FROM JAN 2022 (APPROXIMATE):
// -----------------------------------------------
// Event            | Price | Old Version | This Version
// -----------------+-------+-------------+-------------
// Short entry      | $248  | $248        | $248
// Short cover      | $120  | $120        | $120  (RSI < 28)
// Long re-entry    | $175  | $260        | $175  (SMA50 cross vs SMA200+3%)
// Final price      | $400  | ~+73%       | ~+140% (approx vs B&H +29%)
//
// BEST STOCKS TO TEST IN TRADINGVIEW:
//   TSLA Daily (1D) — set date range 2022-01-01 to today
//   NVDA Daily (1D) — set date range 2022-01-01 to today
//   META Daily (1D) — set date range 2022-01-01 to today
//
// HOW TO TEST:
//   1. Paste into Pine Script Editor → Save → Add to chart
//   2. Set chart date range: 2022-01-01 to today
//   3. Open Strategy Tester → compare Strategy equity vs Buy & hold equity
//   4. Key events: SHORT entry ~May 2022, COVER ~Dec 2022, LONG RECOV ~early 2023

//@version=5
strategy("Strategy 6 — Adaptive L/S + SMA50 Recovery (Beat Growth B&H)", overlay=true, initial_capital=100000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.1, slippage=2)

// ─── Inputs ────────────────────────────────────────────────────────────────
sma_len = input.int(200, "Trend SMA Length (primary trend filter)", minval=50, maxval=400, group="Trend Filter")
sma_fast_len = input.int(50, "Fast SMA for recovery re-entry", minval=10, maxval=100, group="Trend Filter", tooltip="After RSI cover, re-enter LONG when price crosses above this SMA — catches recovery earlier than SMA200+3%")
buf_pct = input.float(3.0, "Buffer Zone % (prevents whipsaw near SMA200)", minval=0.5, maxval=10.0, step=0.5, group="Trend Filter")
atr_len = input.int(14, "ATR Length (trailing stop)", minval=5, group="Risk Management")
atr_mult = input.float(3.0, "ATR Trailing Stop Multiplier", minval=1.0, maxval=6.0, step=0.5, group="Risk Management", tooltip="Long exit: close falls N x ATR below peak. Widens on high-vol stocks to avoid noise exits.")
rsi_cover_level = input.int(28, "Cover Short when RSI below", minval=15, maxval=40, group="Short Management", tooltip="Cover short at extreme oversold — stock at maximum fear, bounce imminent. Locks in crash profit.")
rsi_reshort_min = input.int(50, "Min RSI to re-short after cover", minval=30, maxval=70, group="Short Management", tooltip="After RSI cover, only re-short if RSI recovers above this level (confirms not still at the bottom)")
short_enabled = input.bool(true, "Enable Short Leg (uncheck for long/flat only)", group="Positioning")

// ─── Core Indicators ───────────────────────────────────────────────────────
sma200 = ta.sma(close, sma_len)
sma50 = ta.sma(close, sma_fast_len)
rsi14 = ta.rsi(close, 14)
atr14 = ta.atr(atr_len)

// ─── Zone Detection ────────────────────────────────────────────────────────
bull_zone = close > sma200 * (1 + buf_pct / 100)
bear_zone = close < sma200 * (1 - buf_pct / 100)

// ─── ATR Trailing Stop for Long Positions ──────────────────────────────────
// Stop rises with the stock, never falls. High-vol stocks get wider stops via ATR.
var float trail_stop = na
if strategy.position_size > 0
    trail_stop := math.max(nz(trail_stop, close - atr_mult * atr14), close - atr_mult * atr14)
else
    trail_stop := na

// ─── State Management ──────────────────────────────────────────────────────
var bool rsi_covered = false
if strategy.position_size > 0
    rsi_covered := false

// ─── Entry Logic ───────────────────────────────────────────────────────────
if bar_index >= sma_len
    // LONG — Case 1: Standard bull zone entry (price > SMA200 + buffer)
    if bull_zone and strategy.position_size <= 0
        strategy.entry("Long", strategy.long, comment="LONG — Bull Zone")
        rsi_covered := false
    // LONG — Case 2: Recovery entry after RSI cover
    // After covering the short at oversold levels, re-enter long when price
    // crosses above SMA50. This fires much earlier than SMA200+3%, capturing
    // the bulk of the recovery move (e.g. TSLA $175 vs waiting until $260).
    else if rsi_covered and strategy.position_size <= 0 and ta.crossover(close, sma50)
        strategy.entry("Long", strategy.long, comment="LONG — Recovery (SMA50 cross)")
        rsi_covered := false
    // SHORT — enter when bear zone confirmed AND conditions met
    else if bear_zone and short_enabled and strategy.position_size >= 0
        if not rsi_covered or rsi14 >= rsi_reshort_min
            strategy.entry("Short", strategy.short, comment="SHORT — Bear Zone")

// ─── Exit Logic ────────────────────────────────────────────────────────────
// Cover short when RSI deeply oversold — lock in crash profit before the bounce
if strategy.position_size < 0 and rsi14 < rsi_cover_level
    strategy.close("Short", comment="COVER — RSI=" + str.tostring(math.round(rsi14, 0)) + " oversold, profit locked")
    rsi_covered := true

// ATR trailing stop for long positions — protects accumulated gains
if strategy.position_size > 0 and not na(trail_stop) and close < trail_stop
    strategy.close("Long", comment="ATR Stop — " + str.tostring(math.round(trail_stop, 2)))

// ─── Chart Visuals ─────────────────────────────────────────────────────────
sma_col = bull_zone ? color.green : bear_zone ? color.red : color.gray
plot(sma200, "SMA" + str.tostring(sma_len), color=sma_col, linewidth=2)
plot(sma50, "SMA" + str.tostring(sma_fast_len) + " (recovery entry)", color=color.new(color.blue, 50), linewidth=1)
plot(sma200 * (1 + buf_pct / 100), "Bull Zone +" + str.tostring(buf_pct) + "%", color=color.new(color.green, 70), linewidth=1)
plot(sma200 * (1 - buf_pct / 100), "Bear Zone -" + str.tostring(buf_pct) + "%", color=color.new(color.red, 70), linewidth=1)
plot(strategy.position_size > 0 and not na(trail_stop) ? trail_stop : na, "ATR Trail Stop", color=color.new(color.orange, 20), linewidth=1, style=plot.style_line)

bgcolor(strategy.position_size > 0 ? color.new(color.green, 93) : strategy.position_size < 0 ? color.new(color.red, 93) : color.new(color.gray, 97), title="Position Zone")

plotshape(bull_zone and strategy.position_size > 0 and strategy.position_size[1] <= 0 and not rsi_covered[1], "Long Entry", shape.labelup, location.belowbar, color.new(color.green, 0), text="LONG", textcolor=color.white, size=size.small)
plotshape(rsi_covered[1] and strategy.position_size > 0 and strategy.position_size[1] <= 0, "Recovery Long", shape.labelup, location.belowbar, color.new(color.blue, 0), text="RECOV", textcolor=color.white, size=size.small)
plotshape(bear_zone and strategy.position_size < 0 and strategy.position_size[1] >= 0, "Short Entry", shape.labeldown, location.abovebar, color.new(color.red, 0), text="SHORT", textcolor=color.white, size=size.small)
plotshape(strategy.position_size == 0 and strategy.position_size[1] < 0 and rsi_covered, "RSI Cover", shape.labelup, location.belowbar, color.new(color.orange, 0), text="COVER", textcolor=color.white, size=size.tiny)

// ─── Dashboard Table ───────────────────────────────────────────────────────
var table dash = table.new(position.top_right, 2, 9, bgcolor=color.new(color.black, 75), border_width=1, border_color=color.new(color.gray, 60))
if barstate.islast
    table.cell(dash, 0, 0, "Strategy 6", text_color=color.white, text_size=size.normal, bgcolor=color.new(color.navy, 30))
    table.cell(dash, 1, 0, "Adaptive L/S", text_color=color.white, text_size=size.normal, bgcolor=color.new(color.navy, 30))
    table.cell(dash, 0, 1, "Position", text_color=color.gray, text_size=size.small)
    pos_str = strategy.position_size > 0 ? "LONG" : strategy.position_size < 0 ? "SHORT" : "FLAT"
    pos_col = strategy.position_size > 0 ? color.lime : strategy.position_size < 0 ? color.red : color.gray
    table.cell(dash, 1, 1, pos_str, text_color=pos_col, text_size=size.small, bgcolor=color.new(pos_col, 85))
    table.cell(dash, 0, 2, "Zone", text_color=color.gray, text_size=size.small)
    zone_str = bull_zone ? "BULL (Long)" : bear_zone ? "BEAR (Short)" : "BUFFER (Hold)"
    zone_col = bull_zone ? color.lime : bear_zone ? color.red : color.yellow
    table.cell(dash, 1, 2, zone_str, text_color=zone_col, text_size=size.small)
    table.cell(dash, 0, 3, "SMA" + str.tostring(sma_len), text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 3, str.tostring(math.round(sma200, 2)), text_color=sma_col, text_size=size.small)
    table.cell(dash, 0, 4, "SMA" + str.tostring(sma_fast_len) + " (recov.)", text_color=color.gray, text_size=size.small)
    sma50_col = close > sma50 ? color.lime : color.red
    table.cell(dash, 1, 4, str.tostring(math.round(sma50, 2)), text_color=sma50_col, text_size=size.small)
    table.cell(dash, 0, 5, "ATR Stop", text_color=color.gray, text_size=size.small)
    stop_str = strategy.position_size > 0 and not na(trail_stop) ? str.tostring(math.round(trail_stop, 2)) : "n/a"
    table.cell(dash, 1, 5, stop_str, text_color=color.orange, text_size=size.small)
    table.cell(dash, 0, 6, "RSI(14)", text_color=color.gray, text_size=size.small)
    rsi_col = rsi14 < rsi_cover_level ? color.orange : rsi14 > 70 ? color.red : color.white
    rsi_note = strategy.position_size < 0 ? (rsi14 < rsi_cover_level ? " COVER NOW" : " (hold short)") : ""
    table.cell(dash, 1, 6, str.tostring(math.round(rsi14, 1)) + rsi_note, text_color=rsi_col, text_size=size.small)
    table.cell(dash, 0, 7, "Mode", text_color=color.gray, text_size=size.small)
    mode_str = rsi_covered ? "RECOVERY -- wait SMA" + str.tostring(sma_fast_len) + " cross" : strategy.position_size < 0 ? "SHORTING" : "Normal"
    mode_col = rsi_covered ? color.yellow : strategy.position_size < 0 ? color.red : color.gray
    table.cell(dash, 1, 7, mode_str, text_color=mode_col, text_size=size.small)
    table.cell(dash, 0, 8, "Price/SMA200", text_color=color.gray, text_size=size.small)
    pct_vs_sma = (close - sma200) / sma200 * 100
    pct_col = pct_vs_sma > 0 ? color.lime : color.red
    table.cell(dash, 1, 8, str.tostring(math.round(pct_vs_sma, 1)) + "% vs SMA200", text_color=pct_col, text_size=size.small)
