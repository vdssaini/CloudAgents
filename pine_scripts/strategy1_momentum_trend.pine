// ============================================================================
// Strategy 1 — Adaptive Momentum + Trend Filter
// ============================================================================
// Pine Script v5  |  TradingView Strategy
//
// Exact port of src/strategy.py (MomentumTrendStrategy) and
// src/indicators.py from the CloudAgents backtesting system.
//
// Academic basis
// --------------
//   Jegadeesh & Titman (1993) — cross-sectional momentum
//   Faber (2007) "A Quantitative Approach to Tactical Asset Allocation"
//   Antonacci (2014) — "Dual Momentum Investing"
//
// Signal rules
// ------------
//   ENTRY  (all must be true on the monthly rebalance bar):
//     1. Close > SMA(200)               — uptrend filter
//     2. 6-month momentum > 0           — positive medium-term trend
//        Momentum = log(Close[21] / Close[147])
//        (skip last 21 days to avoid short-term reversal)
//     3. RSI(14) < 75                   — not grossly overbought on entry
//
//   EXIT  (first condition wins, checked every bar):
//     1. Trailing stop: Close < (peak_since_entry − 3 × ATR(14))
//     2. Monthly rebalance: conditions 1–3 no longer satisfied
//
// Position sizing
// ---------------
//   In the Python system weights are inverse-volatility across a 100-stock
//   universe.  In TradingView (single security) this script is fully
//   invested (100 % of equity) when the signal fires — equivalent to
//   running the strategy on one stock from the qualified universe.
//   Size individual positions at 5–10 % of your total portfolio if trading
//   multiple stocks simultaneously.
//
// Recommended stocks  →  see pine_scripts/README.md
// Recommended timeframe  →  Daily (1D)
//
// ============================================================================

//@version=5
strategy(
    title       = "Momentum + Trend Filter (CloudAgents Strategy 1)",
    shorttitle  = "MOM+TREND",
    overlay     = true,
    default_qty_type  = strategy.percent_of_equity,
    default_qty_value = 100,
    initial_capital   = 100000,
    commission_type   = strategy.commission.percent,
    commission_value  = 0.10,    // 0.10% one-way (matches Python fee_rate=0.001)
    slippage          = 5        // ~0.05 % slippage in price ticks approximation
)

// ── Inputs ───────────────────────────────────────────────────────────────────
i_sma_window        = input.int(200,  "Trend SMA window",         minval=50)
i_mom_lookback      = input.int(126,  "Momentum lookback (days)", minval=20,
                        tooltip="6 months ≈ 126 trading days")
i_mom_skip          = input.int(21,   "Skip recent N days",       minval=0,
                        tooltip="Skips last month to avoid short-term reversal")
i_rsi_window        = input.int(14,   "RSI window",               minval=2)
i_rsi_entry_max     = input.float(75.0,"RSI entry maximum",       minval=50, maxval=100,
                        tooltip="Do not enter if RSI > this value")
i_atr_window        = input.int(14,   "ATR window (trailing stop)",minval=2)
i_atr_mult          = input.float(3.0, "ATR trailing stop mult",  minval=0.5, step=0.5,
                        tooltip="Exit if price drops > N × ATR from peak")
i_rebalance_days    = input.int(21,   "Rebalance every N bars",   minval=1,
                        tooltip="Monthly ≈ 21 trading days")

// ── Indicators ───────────────────────────────────────────────────────────────

// 1. Trend filter — SMA(200)
sma200 = ta.sma(close, i_sma_window)
above_sma = close > sma200

// 2. Momentum — log(Close[skip] / Close[skip + lookback])
//    Matches Python: np.log(prices.shift(21) / prices.shift(lookback + 21))
mom_raw = math.log(close[i_mom_skip] / close[i_mom_skip + i_mom_lookback])
positive_momentum = mom_raw > 0

// 3. RSI(14) — Wilder EMA smoothing, same as Python's ewm(alpha=1/14)
//    ta.rsi() uses RMA (Wilder) which is identical to ewm(alpha=1/window)
rsi14 = ta.rsi(close, i_rsi_window)
rsi_ok_entry = rsi14 < i_rsi_entry_max

// 4. ATR(14) for trailing stop
//    ta.atr() uses Wilder RMA, matching Python's ewm(alpha=1/14)
atr14 = ta.atr(i_atr_window)

// ── Trailing Stop Logic ───────────────────────────────────────────────────────
var float peak_price  = na
var bool  in_position = false

// Update peak price while in position
if in_position
    peak_price := math.max(nz(peak_price, close), close)

trailing_stop_level = nz(peak_price, close) - i_atr_mult * atr14
trailing_stop_hit   = in_position and close < trailing_stop_level

// ── Entry / Exit Conditions ───────────────────────────────────────────────────

// Monthly rebalance trigger (every i_rebalance_days bars)
is_rebalance_bar = bar_index % i_rebalance_days == 0

// Entry: all conditions must be true on a rebalance bar
entry_signal = is_rebalance_bar and above_sma and positive_momentum and rsi_ok_entry and not in_position

// Exit on rebalance: trend or momentum broken
exit_signal_rebalance = is_rebalance_bar and in_position and (not above_sma or not positive_momentum)

// ── Execute Orders ────────────────────────────────────────────────────────────
if entry_signal
    strategy.entry("Long", strategy.long)
    in_position := true
    peak_price  := close

if trailing_stop_hit
    strategy.close("Long", comment="Trailing Stop")
    in_position := false
    peak_price  := na

if exit_signal_rebalance
    strategy.close("Long", comment="Rebalance Exit")
    in_position := false
    peak_price  := na

// ── Plots ─────────────────────────────────────────────────────────────────────
plot(sma200, "SMA 200", color=color.new(color.blue, 0), linewidth=2)

// Show trailing stop level only while in position
plot(in_position ? trailing_stop_level : na, "Trailing Stop",
     color=color.new(color.red, 0), style=plot.style_linebr, linewidth=1)

// Momentum signal marker
plotshape(entry_signal, title="Entry", style=shape.triangleup,
          location=location.belowbar, color=color.new(color.green, 0), size=size.small)
plotshape(trailing_stop_hit or exit_signal_rebalance, title="Exit",
          style=shape.triangledown, location=location.abovebar,
          color=color.new(color.red, 0), size=size.small)

// Color background when all conditions are met (even outside position)
all_signals = above_sma and positive_momentum and rsi_ok_entry
bgcolor(all_signals ? color.new(color.green, 92) : na, title="Signal Zone")

// ── Info Table ────────────────────────────────────────────────────────────────
var table info_tbl = table.new(position.top_right, 2, 6,
    bgcolor=color.new(color.white, 10), border_width=1)

if barstate.islast
    table.cell(info_tbl, 0, 0, "Indicator",    text_color=color.gray,  text_size=size.small)
    table.cell(info_tbl, 1, 0, "Value",         text_color=color.gray,  text_size=size.small)
    table.cell(info_tbl, 0, 1, "SMA(200)",      text_size=size.small)
    table.cell(info_tbl, 1, 1, str.tostring(math.round(sma200, 2)),     text_size=size.small)
    table.cell(info_tbl, 0, 2, "Momentum(6m)",  text_size=size.small)
    table.cell(info_tbl, 1, 2, str.tostring(math.round(mom_raw * 100, 2)) + "%", text_size=size.small)
    table.cell(info_tbl, 0, 3, "RSI(14)",        text_size=size.small)
    table.cell(info_tbl, 1, 3, str.tostring(math.round(rsi14, 1)),      text_size=size.small)
    table.cell(info_tbl, 0, 4, "ATR(14)",        text_size=size.small)
    table.cell(info_tbl, 1, 4, str.tostring(math.round(atr14, 2)),      text_size=size.small)
    table.cell(info_tbl, 0, 5, "In Position",    text_size=size.small)
    table.cell(info_tbl, 1, 5, in_position ? "YES" : "NO",
               text_color=in_position ? color.green : color.red,         text_size=size.small)
