// Strategy 2 — Short-Term Mean Reversion (RSI(2) + Bollinger Band)
// Pine Script v5 | TradingView Strategy
// Exact port of src/strategy_mean_reversion.py (MeanReversionStrategy) from the CloudAgents backtesting system.
// Academic basis: Lehmann (1990), Jegadeesh (1990), Connors & Alvarez (2009), Blitz et al. (2011)
// Recommended: Daily (1D) chart. Best stocks: SPY, QQQ, AAPL, JNJ, PG, KO, WMT
//
// ENTRY (checked every 5 bars — weekly scan, all must be true):
//   1. Close > SMA(200)                 — uptrend filter (avoid falling knives)
//   2. Bollinger %B < 0.25              — price near lower band (2-std, 20-bar)
//   3. 5-day return < threshold (%)     — underperformed peers (proxy for cross-sectional z < -1)
//      Use -2% default; -3% for high-vol stocks (NVDA/TSLA); -1.5% for low-vol stocks (JNJ/PG)
//   4. RSI(2) < 20                      — near-term selling exhaustion (simple SMA, not Wilder EMA)
//   5. >= 1 consecutive down day        — confirms selling pressure
// EXIT (first condition wins, checked every bar):
//   1. RSI(2) > 60          — recovery underway
//   2. Bollinger %B > 0.75  — price recovered to upper band
//   3. T+5 time stop        — max hold 5 trading days
//   4. Hard stop-loss: Close < entry * (1 - 7%)

//@version=5
strategy(title="Mean Reversion RSI2+BB (CloudAgents Strategy 2)", shorttitle="MR-RSI2", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=100, initial_capital=100000, commission_type=strategy.commission.percent, commission_value=0.10, slippage=5)

// ── Inputs ────────────────────────────────────────────────────────────────────
i_sma_window        = input.int(200,    "Trend SMA window",            minval=50)
i_bb_window         = input.int(20,     "Bollinger Band window",       minval=5)
i_bb_mult           = input.float(2.0,  "Bollinger Band std mult",     minval=0.5, step=0.5)
i_bb_entry_pct_b    = input.float(0.25, "BB %B entry threshold",       minval=0.0, maxval=0.5, tooltip="Enter when %B < this. Python default: 0.25")
i_bb_exit_pct_b     = input.float(0.75, "BB %B exit threshold",        minval=0.5, maxval=1.0, tooltip="Exit when %B > this. Python default: 0.75")
i_rsi2_entry        = input.float(20.0, "RSI(2) entry threshold",      minval=1,   maxval=50,  tooltip="Enter when RSI(2) < this. Python default: 20")
i_rsi2_exit         = input.float(60.0, "RSI(2) exit threshold",       minval=50,  maxval=99,  tooltip="Exit when RSI(2) > this. Python default: 60")
i_fiveday_threshold = input.float(-2.0, "5-day return threshold (%)",  minval=-10, maxval=0, step=0.5, tooltip="Proxy for cross-sectional z-score < -1. Default -2%. Use -3% for high-vol (NVDA/TSLA), -1.5% for low-vol (JNJ/PG).")
i_min_down_days     = input.int(1,      "Min consecutive down days",   minval=1,   tooltip="Streak filter. Python default: 1")
i_time_stop         = input.int(5,      "Time stop (bars)",            minval=1,   tooltip="Exit after N bars regardless. Python default: 5")
i_hard_stop_pct     = input.float(7.0,  "Hard stop-loss (%)",          minval=1, maxval=20, tooltip="Exit if price drops > N% from entry. Python default: 7%")
i_rebalance_days    = input.int(5,      "Scan every N bars",           minval=1,   tooltip="Weekly = 5 trading days. Python default: 5")

// ── Indicators ────────────────────────────────────────────────────────────────
// 1. Trend filter
sma200    = ta.sma(close, i_sma_window)
above_sma = close > sma200

// 2. Bollinger %B — matches Python: (close - lower) / (upper - lower)
[bb_mid, bb_upper, bb_lower] = ta.bb(close, i_bb_window, i_bb_mult)
band_width = bb_upper - bb_lower
pct_b      = band_width > 0 ? (close - bb_lower) / band_width : na

// 3. RSI(2) with SIMPLE moving average — matches Python's rsi_fast() which uses rolling(2).mean()
// ta.rsi() uses Wilder RMA and is NOT the same. We implement manually with ta.sma().
rsi2_period = 2
delta_      = ta.change(close)
gain_       = math.max(delta_, 0.0)
loss_       = math.max(-delta_, 0.0)
avg_gain_   = ta.sma(gain_, rsi2_period)
avg_loss_   = ta.sma(loss_, rsi2_period)
rsi2 = (avg_gain_ == 0 and avg_loss_ == 0) ? na : avg_loss_ == 0 ? 100.0 : 100.0 - 100.0 / (1.0 + avg_gain_ / avg_loss_)

// 4. Consecutive down days — matches Python's consecutive_down_days() (resets to 0 on up day)
var int streak = 0
streak := close < close[1] ? streak[1] + 1 : 0
enough_streak = streak >= i_min_down_days

// 5. 5-day return — proxy for cross-sectional z-score < -1 condition
fiveday_return = (close / close[5] - 1.0) * 100.0
weak_5day      = fiveday_return < i_fiveday_threshold

// ── Entry Condition (all must be true) ────────────────────────────────────────
is_scan_bar  = bar_index % i_rebalance_days == 0
entry_signal = is_scan_bar and above_sma and not na(pct_b) and pct_b < i_bb_entry_pct_b and not na(rsi2) and rsi2 < i_rsi2_entry and enough_streak and weak_5day

// ── Position Tracking ─────────────────────────────────────────────────────────
var int   entry_bar   = na
var float entry_price = na
in_position = strategy.position_size > 0

if entry_signal and not in_position
    entry_bar   := bar_index
    entry_price := close

// ── Exit Conditions ───────────────────────────────────────────────────────────
bars_held = in_position ? bar_index - nz(entry_bar, bar_index) : 0
exit_rsi2 = in_position and not na(rsi2) and rsi2 > i_rsi2_exit
exit_bb   = in_position and not na(pct_b) and pct_b > i_bb_exit_pct_b
exit_time = in_position and bars_held >= i_time_stop
exit_stop = in_position and not na(entry_price) and close < entry_price * (1.0 - i_hard_stop_pct / 100.0)
any_exit  = exit_rsi2 or exit_bb or exit_time or exit_stop

// ── Execute Orders ────────────────────────────────────────────────────────────
if entry_signal and not in_position
    strategy.entry("Long", strategy.long)

if exit_rsi2
    strategy.close("Long", comment="RSI2 Exit")
    entry_bar   := na
    entry_price := na

if exit_bb and not exit_rsi2
    strategy.close("Long", comment="%B Exit")
    entry_bar   := na
    entry_price := na

if exit_time and not exit_rsi2 and not exit_bb
    strategy.close("Long", comment="Time Stop")
    entry_bar   := na
    entry_price := na

if exit_stop and not exit_rsi2 and not exit_bb and not exit_time
    strategy.close("Long", comment="Hard Stop -7%")
    entry_bar   := na
    entry_price := na

// ── Plots ─────────────────────────────────────────────────────────────────────
plot(sma200,    "SMA 200",   color=color.new(color.blue, 0),  linewidth=2)
plot(bb_upper,  "BB Upper",  color=color.new(color.gray, 60), linewidth=1)
plot(bb_mid,    "BB Mid",    color=color.new(color.gray, 40), linewidth=1)
plot(bb_lower,  "BB Lower",  color=color.new(color.gray, 60), linewidth=1)
plot(in_position and not na(entry_price) ? entry_price * (1.0 - i_hard_stop_pct / 100.0) : na, "Hard Stop", color=color.new(color.red, 0), style=plot.style_linebr, linewidth=1)
plotshape(entry_signal, title="Entry", style=shape.triangleup, location=location.belowbar, color=color.new(color.green, 0), size=size.small)
plotshape(any_exit, title="Exit", style=shape.triangledown, location=location.abovebar, color=color.new(color.red, 0), size=size.small)
all_cond = above_sma and not na(pct_b) and pct_b < i_bb_entry_pct_b and not na(rsi2) and rsi2 < i_rsi2_entry and enough_streak and weak_5day
bgcolor(all_cond ? color.new(color.green, 90) : na, title="All Conditions Met")

// ── Info Table ────────────────────────────────────────────────────────────────
var table info_tbl = table.new(position.top_right, 2, 8, bgcolor=color.new(color.white, 10), border_width=1)
if barstate.islast
    table.cell(info_tbl, 0, 0, "Indicator",    text_color=color.gray, text_size=size.small)
    table.cell(info_tbl, 1, 0, "Value",         text_color=color.gray, text_size=size.small)
    table.cell(info_tbl, 0, 1, "SMA(200)",      text_size=size.small)
    table.cell(info_tbl, 1, 1, str.tostring(math.round(sma200, 2)), text_size=size.small)
    table.cell(info_tbl, 0, 2, "Bollinger %B",  text_size=size.small)
    table.cell(info_tbl, 1, 2, not na(pct_b) ? str.tostring(math.round(pct_b, 3)) : "N/A", text_color=not na(pct_b) and pct_b < i_bb_entry_pct_b ? color.green : color.black, text_size=size.small)
    table.cell(info_tbl, 0, 3, "RSI(2)",        text_size=size.small)
    table.cell(info_tbl, 1, 3, not na(rsi2) ? str.tostring(math.round(rsi2, 1)) : "N/A", text_color=not na(rsi2) and rsi2 < i_rsi2_entry ? color.green : color.black, text_size=size.small)
    table.cell(info_tbl, 0, 4, "5-day Ret%",    text_size=size.small)
    table.cell(info_tbl, 1, 4, str.tostring(math.round(fiveday_return, 2)) + "%", text_color=weak_5day ? color.green : color.black, text_size=size.small)
    table.cell(info_tbl, 0, 5, "Down Streak",   text_size=size.small)
    table.cell(info_tbl, 1, 5, str.tostring(streak), text_color=enough_streak ? color.green : color.black, text_size=size.small)
    table.cell(info_tbl, 0, 6, "Bars Held",     text_size=size.small)
    table.cell(info_tbl, 1, 6, str.tostring(bars_held), text_size=size.small)
    table.cell(info_tbl, 0, 7, "In Position",   text_size=size.small)
    table.cell(info_tbl, 1, 7, in_position ? "YES" : "NO", text_color=in_position ? color.green : color.red, text_size=size.small)
